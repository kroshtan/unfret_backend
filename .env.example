# Copy to .env and fill in. Every setting in src/unfret/config.py can be
# overridden with an UNFRET_-prefixed environment variable.

# Any OpenAI-compatible chat completions API; Scaleway Generative APIs by default.
UNFRET_LLM_API_KEY=
# UNFRET_LLM_BASE_URL=https://api.scaleway.ai/v1
# UNFRET_LLM_MODEL=mistral-small-3.2-24b-instruct-2506

# Sign-In With Solana and credits. Off (503) while empty; generate with `openssl rand -hex 32`.
UNFRET_SESSION_SECRET=
# UNFRET_SIWS_DOMAIN=unfret.net
# UNFRET_ANALYSIS_PRICE_LAMPORTS=1500000       # 0.0015 SOL per analysis

# Optional: x402 pay-per-check (POST /v1/check) and buying credits. Off until both are set; devnet by default.
# UNFRET_HOT_WALLET_KEY=              # hot key (base58 or Solana CLI JSON array): receives payments, pays fees, sweeps to cold
# UNFRET_COLD_ADDRESS=                # cold wallet public key (e.g. a Ledger); the only sweep destination
# UNFRET_SWEEP_THRESHOLD_LAMPORTS=100000000   # sweep above 0.1 SOL
# UNFRET_SWEEP_RESERVE_LAMPORTS=10000000      # keep 0.01 SOL for fees
# UNFRET_SOLANA_NETWORK=solana-devnet
# UNFRET_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: card top-ups for API keys through Polar (Merchant of Record). Off unless all four are set.
# UNFRET_POLAR_ACCESS_TOKEN=          # Organization Access Token, scope checkouts:write only
# UNFRET_POLAR_ENVIRONMENT=sandbox    # or production (real money); token, products and webhook from the same one
# UNFRET_POLAR_PRODUCTS=25=<product id>,50=<product id>,100=<product id>
# UNFRET_FIAT_WEBHOOK_SECRET=whsec_...  # the endpoint for /v1/webhooks/fiat (order.paid, order.refunded, refund.*)
