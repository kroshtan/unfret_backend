# Copy to .env and fill in. Every setting in src/veridex/config.py can be
# overridden with a VERIDEX_-prefixed environment variable.

# Any OpenAI-compatible chat completions API; Scaleway Generative APIs by default.
VERIDEX_LLM_API_KEY=
# VERIDEX_LLM_BASE_URL=https://api.scaleway.ai/v1
# VERIDEX_LLM_MODEL=mistral-small-3.2-24b-instruct-2506

# Sign-In With Solana and credits. Off (503) while empty; generate with `openssl rand -hex 32`.
VERIDEX_SESSION_SECRET=
# VERIDEX_SIWS_DOMAIN=veridex.kroshtan.com
# VERIDEX_ANALYSIS_PRICE_LAMPORTS=1500000       # 0.0015 SOL per analysis

# Optional: x402 pay-per-check (POST /v1/check) and buying credits. Off until both are set; devnet by default.
# VERIDEX_HOT_WALLET_KEY=              # hot key (base58 or Solana CLI JSON array): receives payments, pays fees, sweeps to cold
# VERIDEX_COLD_ADDRESS=                # cold wallet public key (e.g. a Ledger); the only sweep destination
# VERIDEX_SWEEP_THRESHOLD_LAMPORTS=100000000   # sweep above 0.1 SOL
# VERIDEX_SWEEP_RESERVE_LAMPORTS=10000000      # keep 0.01 SOL for fees
# VERIDEX_SOLANA_NETWORK=solana-devnet
# VERIDEX_SOLANA_RPC_URL=https://api.devnet.solana.com
