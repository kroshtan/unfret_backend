# Kamal reads these from the environment; no value is ever committed. CI exports KAMAL_REGISTRY_PASSWORD from the
# deploy runner's credential files and the rest from repo secrets of the same names (.forgejo/workflows/ci.yaml).
# To deploy by hand, export them first.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
VERIDEX_LLM_API_KEY=$VERIDEX_LLM_API_KEY
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
VERIDEX_POSTGRES_URI=postgresql://veridex:$POSTGRES_PASSWORD@veridex-db:5432/veridex
# Optional; empty keeps the feature off.
VERIDEX_SESSION_SECRET=$VERIDEX_SESSION_SECRET
VERIDEX_HOT_WALLET_KEY=$VERIDEX_HOT_WALLET_KEY
VERIDEX_COLD_ADDRESS=$VERIDEX_COLD_ADDRESS
VERIDEX_TINEYE_API_KEY=$VERIDEX_TINEYE_API_KEY
