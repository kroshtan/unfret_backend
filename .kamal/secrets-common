# Kamal reads .kamal/secrets-common plus .kamal/secrets.<destination> (dev or production); no value is ever committed.
# CI exports KAMAL_REGISTRY_PASSWORD from the deploy runner's credential files and the rest from repo secrets
# (.forgejo/workflows/ci.yaml for dev, deploy-production.yaml for production). To deploy by hand, export them first.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
UNFRET_LLM_API_KEY=$UNFRET_LLM_API_KEY
