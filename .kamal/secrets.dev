# dev (devnet). CI maps the DEV_* repo secrets onto these names. Optional ones may be empty: the feature stays off.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
VERIDEX_POSTGRES_URI=postgresql://veridex:$POSTGRES_PASSWORD@veridex-dev-db:5432/veridex
VERIDEX_SESSION_SECRET=$VERIDEX_SESSION_SECRET
VERIDEX_HOT_WALLET_KEY=$VERIDEX_HOT_WALLET_KEY
VERIDEX_COLD_ADDRESS=$VERIDEX_COLD_ADDRESS
VERIDEX_ADMIN_TOKEN=$VERIDEX_ADMIN_TOKEN
VERIDEX_POLAR_ACCESS_TOKEN=$VERIDEX_POLAR_ACCESS_TOKEN
VERIDEX_POLAR_ENVIRONMENT=$VERIDEX_POLAR_ENVIRONMENT
VERIDEX_POLAR_PRODUCTS=$VERIDEX_POLAR_PRODUCTS
VERIDEX_FIAT_WEBHOOK_SECRET=$VERIDEX_FIAT_WEBHOOK_SECRET
