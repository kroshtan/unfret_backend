# dev (devnet). CI maps the DEV_* repo secrets onto these names. Optional ones may be empty: the feature stays off.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
UNFRET_POSTGRES_URI=postgresql://unfret:$POSTGRES_PASSWORD@unfret-dev-db:5432/unfret
UNFRET_SESSION_SECRET=$UNFRET_SESSION_SECRET
UNFRET_HOT_WALLET_KEY=$UNFRET_HOT_WALLET_KEY
UNFRET_COLD_ADDRESS=$UNFRET_COLD_ADDRESS
UNFRET_ADMIN_TOKEN=$UNFRET_ADMIN_TOKEN
UNFRET_POLAR_ACCESS_TOKEN=$UNFRET_POLAR_ACCESS_TOKEN
UNFRET_POLAR_ENVIRONMENT=$UNFRET_POLAR_ENVIRONMENT
UNFRET_POLAR_PRODUCTS=$UNFRET_POLAR_PRODUCTS
UNFRET_FIAT_WEBHOOK_SECRET=$UNFRET_FIAT_WEBHOOK_SECRET
UNFRET_X402_BASE_HOT_KEY=$UNFRET_X402_BASE_HOT_KEY
UNFRET_BASE_PAY_TO=$UNFRET_BASE_PAY_TO
UNFRET_BASE_COLD_ADDRESS=$UNFRET_BASE_COLD_ADDRESS
UNFRET_CDP_API_KEY_ID=$UNFRET_CDP_API_KEY_ID
UNFRET_CDP_API_KEY_SECRET=$UNFRET_CDP_API_KEY_SECRET
