# production (mainnet). The deploy-production workflow maps the PROD_* repo secrets onto these names and refuses to
# run while any of them is empty.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
UNFRET_POSTGRES_URI=postgresql://unfret:$POSTGRES_PASSWORD@unfret-prod-db:5432/unfret
UNFRET_SOLANA_RPC_URL=$UNFRET_SOLANA_RPC_URL
UNFRET_SESSION_SECRET=$UNFRET_SESSION_SECRET
UNFRET_HOT_WALLET_KEY=$UNFRET_HOT_WALLET_KEY
UNFRET_COLD_ADDRESS=$UNFRET_COLD_ADDRESS
UNFRET_ADMIN_TOKEN=$UNFRET_ADMIN_TOKEN
# Card top-ups (Polar, production environment): optional, but all three or none.
UNFRET_POLAR_ACCESS_TOKEN=$UNFRET_POLAR_ACCESS_TOKEN
UNFRET_POLAR_PRODUCTS=$UNFRET_POLAR_PRODUCTS
UNFRET_FIAT_WEBHOOK_SECRET=$UNFRET_FIAT_WEBHOOK_SECRET
