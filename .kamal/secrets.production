# production (mainnet). The deploy-production workflow maps the PROD_* repo secrets onto these names and refuses to
# run while any of them is empty.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
VERIDEX_POSTGRES_URI=postgresql://veridex:$POSTGRES_PASSWORD@veridex-prod-db:5432/veridex
VERIDEX_SOLANA_RPC_URL=$VERIDEX_SOLANA_RPC_URL
VERIDEX_SESSION_SECRET=$VERIDEX_SESSION_SECRET
VERIDEX_HOT_WALLET_KEY=$VERIDEX_HOT_WALLET_KEY
VERIDEX_COLD_ADDRESS=$VERIDEX_COLD_ADDRESS
VERIDEX_ADMIN_TOKEN=$VERIDEX_ADMIN_TOKEN
VERIDEX_VISION_API_KEY=$VERIDEX_VISION_API_KEY
